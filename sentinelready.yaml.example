# ─────────────────────────────────────────────────────────────
# SentinelReady Configuration
# Copy this file to sentinelready.yaml and edit for your environment
# ─────────────────────────────────────────────────────────────

# ── AI PROVIDER ───────────────────────────────────────────────
ai:
  # Ships with Ollama by default (free, runs locally, works out of the
  # box). You can point this at Claude or any OpenAI-compatible API
  # instead (OpenAI, Azure OpenAI, Groq, Together.ai, OpenRouter, local
  # vLLM/LM Studio) in either edition — you bring your own API key and
  # that provider bills you directly; SentinelReady never sees or proxies
  # the cost. This setting isn't license-gated.
  enabled: true
  provider: ollama               # ollama | claude | openai_compatible
  model: llama3.1                # Ollama model to use
  # Where Ollama lives. The default points at the one docker-compose
  # starts for you — leave it alone if you're using the bundled setup.
  #
  # ALREADY RUNNING OLLAMA? Point this at it instead of running a second
  # copy (two instances each hold a multi-GB model resident and contend
  # for the same GPU). Run ./setup.sh — it detects an existing Ollama and
  # tells you exactly what to set. It will never modify, upgrade or
  # restart an Ollama it didn't start; that one may be serving other
  # workloads, so any change to it stays your call.
  #   ollama_host: http://192.168.1.50:11434
  # then start with:
  #   docker compose -f docker-compose.yml -f docker-compose.external-ollama.yml up -d
  #
  # Ollama binds to 127.0.0.1 by default and won't accept connections from
  # a container — set OLLAMA_HOST=0.0.0.0 on that host and restart it.
  ollama_host: http://ollama:11434

  # ── openai_compatible only — ignored for ollama/claude ──
  # base_url: https://api.openai.com/v1        # or Groq/Together/OpenRouter/vLLM/etc.
  # model: gpt-4o-mini                          # overrides the Ollama model line above
  # auth_header_style: bearer                   # bearer (most providers) | api-key (Azure OpenAI)
  # api_version: ""                             # Azure only, e.g. 2024-10-21
  # API key is never stored here — set SENTINEL_AI_API_KEY as an env var
  # (same treatment as ANTHROPIC_API_KEY for Claude).

  # ── Cost Management (Claude / OpenAI-compatible only) ──
  # SR processes every alert — a noisy environment can generate
  # significant API calls in the first few weeks before pattern
  # recognition reduces them. Set a monthly spending limit before
  # connecting SR to production alert traffic:
  #   Claude API: $20/mo at console.anthropic.com -> Settings -> Billing
  #     -> Monthly spend limit
  #   OpenAI API: $20/mo at platform.openai.com -> Settings -> Billing
  #     -> Usage limits
  # SR gets cheaper over time as pattern recognition eliminates repeat
  # AI calls — most customers see 80% cost reduction within 90 days.
  #
  # Optional local $ estimate + warning, on top of the hard spend limit
  # you set above (SR is BYO-key everywhere and never sees your real
  # invoice, so this is a second, local-only signal, not a replacement).
  # No safe default rate exists since pricing varies by model and changes
  # over time — both default to 0 (off) until you fill in your model's
  # current per-1K-token rates from your provider's pricing page:
  # Rates as of 2026-08-31 -- check your provider's pricing page, these
  # change. Claude, per 1K tokens:
  #   Opus 5     input 0.005   output 0.025
  #   Sonnet 5   input 0.002   output 0.010
  #   Haiku 4.5  input 0.001   output 0.005
  # cost_per_1k_input_tokens: 0.005
  # cost_per_1k_output_tokens: 0.025
  # daily_budget_usd: 5.00           # one warning email/day once crossed; 0 = off

  # Whether the full original alert payload (not just the extracted
  # name/severity/description/value fields) gets included in the AI
  # triage prompt. Default true — alert data essentially never contains
  # anything worth withholding from the AI doing the triage, and this
  # gives it access to whatever extra detail your monitoring tool sends
  # that SentinelReady's normalizer doesn't explicitly extract. Set false
  # if you have a specific reason to keep the raw payload out of the
  # prompt.
  # include_raw_payload: true

# ── CUSTOMER ──────────────────────────────────────────────────
# ── API reference ─────────────────────────────────────────────────────────
# SentinelReady ships a full interactive API reference, generated from the
# code itself so it can never drift: /docs (interactive), /redoc (reference)
# and /openapi.json (machine-readable, for generating a client).
#
# Off by default. It requires no credentials, so anyone who can reach port
# 8000 would get a complete map of every route and its parameters. That leaks
# no data and opens no endpoint -- they all still require your webhook secret
# -- but it is a convenience for an attacker, and this port is one the README
# tells you to point alerting tools at, including hosted ones.
#
# On an internal-only deployment there is little reason not to enable it.
api:
  docs_enabled: false

# ── Self-repair ───────────────────────────────────────────────────────────
# SentinelReady checks its own pattern library once a day and repairs entries
# that have become unusable. Three things can happen to a learned verdict:
#
#   - it gets flagged for review, which blocks it from ever being reused, so
#     the pattern pays for a full AI call every time it fires
#   - a verdict about several alerts firing together gets stored against one
#     of them, so that alert later serves a judgement about an incident that
#     is not happening
#   - the stored verdict and its summary drift apart, which stops the pattern
#     from ever gaining confidence
#
# None of these heal on their own: the pattern is either never reused (so
# never re-examined) or always reused (so never re-examined). Repair clears
# the bad verdict; the next occurrence is analysed fresh.
#
# Runs at 03:00 local. Set another hour, or null to disable and run it
# yourself with `--cure --clean`.
maintenance:
  poison_check_hour: 3

customer:
  # Your team or company name — used to tag all alerts and patterns
  default_code: myteam

  # Used to authenticate incoming webhook calls — must match the secret
  # you configure in your alerting tool (Grafana, CloudWatch, Datadog,
  # Slack, UDM, or generic). Leave as-is if you want: SentinelReady will
  # auto-generate a real secret on first run and print it to the logs
  # (`docker compose logs sentinelready`) along with setup instructions.
  # Set your own value here instead if you'd rather choose it yourself.
  webhook_secret: change-me-please

  # Separate password for the config Web UI (/ui) — not the same as
  # webhook_secret above. Same auto-generate-and-print-to-logs behavior
  # if you leave this as-is. Change it any time from the UI's own Admin
  # page once you're logged in.
  dashboard_password: change-me-please

# ── DELIVERY ──────────────────────────────────────────────────
delivery:
  # local = log only (default, good for getting started)
  # smtp  = send email (configure smtp section below)
  mode: local

  # Who gets paged — add real email addresses. A carrier email-to-SMS
  # gateway address (e.g. number@tmomail.net) works here too -- it's
  # still just an email address as far as SentinelReady is concerned.
  # Full carrier gateway table in README.md under "SMS Delivery".
  # Community: 1 delivery target total across every route/webhook combined
  # (see SPEC-delivery-target-cap.md) -- the default below is already right
  # at that limit (all three routes point to the same one address). Add a
  # second distinct address/webhook (e.g. uncomment "all" below) and
  # SentinelReady will tell you it needs Pro.
  routes:
    sre:  ["you@yourcompany.com"]
    ops:  ["you@yourcompany.com"]
    all:  ["you@yourcompany.com"]
    # all:  ["you@yourcompany.com", "oncall@yourcompany.com"]  # Pro: 2nd target

  # SMTP settings (only needed if mode: smtp)
  smtp:
    host: null           # e.g. smtp.gmail.com
    port: 587
    username: null
    password: null
    use_tls: true
    from_addr: sentinelready@yourcompany.com

  # Outbound webhooks (optional) — SentinelReady fires its own triage
  # payload at these URLs, one list per tier. "critical"/"high" fire per
  # alert, in real time, same moment as any SMS/push escalation. "sitrep"
  # fires once per digest, alongside the sitrep email. Leave empty (the
  # default) to skip this entirely — nothing here is required.
  #
  # type: pagerduty — sends PagerDuty Events API v2 format. Get
  #   routing_key from your PagerDuty service's integration settings.
  # type: slack — sends Slack's incoming-webhook format (a plain URL from
  #   Slack's "Incoming Webhooks" app).
  # type: generic (or omit type) — SentinelReady's own plain JSON
  #   (alert + brief for critical/high, the full sitrep report for
  #   sitrep) — point this at anything that accepts a JSON POST.
  # headers: optional custom headers on any entry (e.g. an Authorization
  #   bearer token your own endpoint requires).
  webhooks:
    critical: []
    high: []
    sitrep: []
    # Example:
    # critical:
    #   - type: pagerduty
    #     url: https://events.pagerduty.com/v2/enqueue
    #     routing_key: your-pagerduty-integration-key
    #   - type: slack
    #     url: https://hooks.slack.com/services/T000/B000/XXXXXXXX
    # high:
    #   - type: slack
    #     url: https://hooks.slack.com/services/T000/B000/XXXXXXXX
    # sitrep:
    #   - type: generic
    #     url: https://your-endpoint.example.com/ingest
    #     headers:
    #       Authorization: "Bearer your-token"

  # This whole webhooks section is also settable per customer_code via
  # POST /delivery/policy (same endpoint routes/sitrep/summary already
  # use) — see MULTI-SITE-SETUP.md if running one instance across
  # multiple sites and each site needs its own webhook targets.

# ── SITREP / SUMMARY DELIVERY ─────────────────────────────────
# SentinelReady can send you a periodic digest (a "sitrep") of everything
# it's seen and done — off by default until you set real recipients here.
# Once enabled, SentinelReady schedules and sends these itself on the
# cadence below (built-in scheduler, checks every 15 min) — nothing else
# to set up, no external cron needed.
sitrep:
  enabled: false
  cadence: daily        # daily | weekly | monthly
  recipients: []         # e.g. ["you@yourcompany.com"]

# Optional second digest at a different cadence — e.g. a high-level
# weekly summary for management alongside a daily operational sitrep.
# Independent of the sitrep section above; leave disabled if you only
# want one.
summary:
  enabled: false
  cadence: weekly        # daily | weekly | monthly
  recipients: []

# ── DATA PATHS ────────────────────────────────────────────────
history:
  # Leave these as-is — data directory is mounted as a Docker volume
  db_path: /app/scripts/data/sentinel_history.db
  events_file: /app/scripts/data/events.jsonl

fingerprint:
  db_path: /app/scripts/data/sentinel_fingerprints.db
  cache_enabled: true
  min_confidence: 0.7

# ── ALERTING ──────────────────────────────────────────────────
alerting:
  # Severities listed here always page — never suppressed, never
  # downgraded, never flood-aggregated, regardless of learned-pattern
  # confidence or AI judgment. Not license-gated, free in both editions.
  # Matches the incoming alert's own "severity" field. Defaults to
  # [critical] so the guarantee applies out of the box — remove entries
  # or set to [] if you'd rather every severity go through normal AI
  # judgment instead.
  sacred_severities: [critical]
  # Example: sacred_severities: [critical, high]

# ── MULTI-SIGNAL CORRELATION ──────────────────────────────────
correlation:
  # How close together (minutes) different alerts for the same team need
  # to fire to be treated as one combined incident instead of separate
  # ones (see "Manual Overrides" section above for the related
  # suppress/always-alert mechanism). 15 min is a reasonable default for
  # most cascading-failure scenarios — widen it if your infrastructure's
  # failures tend to unfold more slowly.
  window_minutes: 15

# ── PATTERN OVERRIDES ──────────────────────────────────────────
overrides:
  # Default suppression/always-alert length (days) when POST /suppress or
  # POST /always-alert omits "expires" and doesn't set "permanent": true.
  # Never silently permanent — see the "Manual Overrides" README section.
  default_expiry_days: 14

# ── REPEAT SUPPRESSION ─────────────────────────────────────────
repeat_suppression:
  # Collapses a notification that says nothing new. Suppresses ONLY an
  # identical restatement — same pattern, same host, same description,
  # same urgency, same escalate decision — of something already sent
  # within this window.
  #
  # A recurrence carrying new information is NEVER suppressed, no matter
  # how often it happens: a genuinely new restart, a rising count, a new
  # host, or a raised urgency all produce a different notification and go
  # out immediately. This exists for upstream rules that re-report one
  # unchanged event forever (the classic being a cumulative counter
  # compared to zero, e.g. `kube_pod_container_status_restarts_total > 0`,
  # which stays true for the life of the pod). Repeatedly restarting pods
  # are a real problem and still reach you every time.
  #
  # When delivery resumes, the notification reports how many identical
  # repeats were swallowed, so a compressed burst never reads as a
  # one-off. Set to 0 to disable suppression entirely.
  window_minutes: 60

# ── BURST DETECTION ────────────────────────────────────────────
burst:
  # When several alerts for the same service arrive close together,
  # SentinelReady stops trusting its cached "this is routine" verdict and
  # re-triages with the AI. A pattern that was harmless yesterday may be a
  # symptom of something real once it starts firing repeatedly, and the
  # cache cannot know that.
  #
  # You will see this in the logs as:
  #   Cache bypassed — burst signal detected for HighCPU (recent_same_service=4,
  #   threshold=3, window=10m) — re-triaging once, then reusing that result
  #
  # This is normal and intentional. If you are evaluating the pattern
  # cache by firing the same test alert repeatedly, this is why you see AI
  # calls instead of instant cache hits — space the test alerts out past
  # service_window_minutes, or set same_service_threshold higher.
  same_service_threshold: 3   # alerts for one service+type before a burst is called
  same_node_threshold: 2      # alerts for one node+type before a burst is called
  service_window_minutes: 10  # rolling window for the service counter
  node_window_minutes: 5      # rolling window for the node counter

  # How often a burst may force a fresh triage for the SAME pattern.
  # The first alert of a burst re-triages; the rest reuse that fresh
  # result until this interval passes. Without it, every alert in a burst
  # paid for its own inference — 18 identical alerts meant 18 model calls
  # and zero cache hits, even at 0.98 confidence. Set to 0 to re-triage on
  # every alert of a burst (the old behaviour, not recommended).
  # NO LONGER USED (2026-09-01). A burst no longer forces a fresh triage --
  # it reuses the cached decision and escalates it to the digest instead --
  # so there is nothing left for this to rate-limit. Accepted without error
  # so existing configs keep loading; removed in 1.1.
  refresh_interval_minutes: 30

# ── AI CALL GOVERNOR ───────────────────────────────────────────
governor:
  # Hard ceiling on how many AI enrichment calls SentinelReady will make.
  # This is a runaway-cost brake, not a tuning knob — with a paid BYOK
  # provider, an alert storm could otherwise generate a very large bill
  # before you noticed.
  #
  # When a ceiling is reached, alerts are still DELIVERED — they just
  # arrive raw and unenriched (reason code `enrichment_paused`) instead of
  # triaged. Nothing is ever dropped. The daily counter resets at UTC
  # midnight, and your sitrep reports how many alerts were affected.
  #
  # Most steady-state installs stay far below these: once patterns are
  # learned, repeat alerts are served from cache and cost nothing. The
  # likeliest time to hit the daily cap is your FIRST few days, when
  # nothing is cached yet and every new pattern is a fresh AI call. If you
  # are onboarding a noisy environment and see `enrichment_paused` in the
  # logs or sitrep, raise max_calls_per_day rather than assume AI broke.
  max_calls_per_minute: 20
  max_calls_per_day: 500


# ── LOGGING ────────────────────────────────────────────────────
logging:
  # SentinelReady writes its log beside the databases, inside the data
  # volume, so it survives container restarts — a log that vanishes on
  # redeploy loses exactly the evidence you need to explain what went wrong.
  #
  # Rotation is always on. max_bytes x (backup_count + 1) is the hard ceiling
  # on total disk used; because the log shares a volume with your pattern
  # databases, an unbounded log would eventually fill the space they need.
  max_bytes: 10000000      # 10 MB per file
  backup_count: 3          # keep 3 rotations — 40 MB total ceiling

# ── LICENSE ───────────────────────────────────────────────────
license:
  # Your edition. Leave as `community` unless you have a paid key.
  #
  # IMPORTANT for Pro/Multi-Site customers: a valid license key on its own
  # is NOT enough — you must ALSO set this to `pro` (or your Multi-Site
  # tier). A key with `tier: community` here leaves the instance on
  # Community limits.
  tier: community

  # Community caps. These are IGNORED on Pro/Multi-Site — that tier is
  # genuinely unlimited and the code bypasses these values entirely, so
  # there is no need (and no benefit) to raising them by hand after
  # upgrading. Lower them if you want a *tighter* limit than Community's
  # default; raising them does not grant anything.
  max_patterns: 50
  max_users: 1
  # Community gets a taste of sitreps before hitting the paywall — the
  # first N sitrep sends (lifetime, per customer_code) go out in full;
  # after that, /sitrep/send returns a preview only until you upgrade.
  free_sitreps: 5
  mobile_push: false
  # Outcome learning and pattern sequences are free in both Community and
  # Pro — not license-gated. Set to false yourself if you'd rather
  # SentinelReady not track alert outcomes at all.
  #
  # What this records (2026-09-03): that an alert fired and later cleared,
  # and how long that took. Both come from your alerting system and are real.
  # What it does NOT record is whether a human fixed it — nothing can observe
  # that, so nothing infers it. If you want that distinction captured, report
  # it: POST /outcomes/{fingerprint_hash}/intervened with a short note.
  #
  # Until 1.0.6 this setting also let SentinelReady promote a pattern to
  # `suppress` on its own, based on how often alerts appeared to resolve
  # themselves — a figure it could not actually measure. That behaviour is
  # disabled. Learning still runs on what is real: how long things take, how
  # often they fire, and any interventions you report.
  outcome_learning: true
  pattern_sequences: true

  # ── Pro/Multi-Site subscriptions — REQUIRED if you bought one ──
  # Set this to the license key emailed to you at purchase. This is what
  # makes a subscription renew: SentinelReady checks in every 12h, gets a
  # fresh internal signed key, and applies it with no restart, so you
  # never re-enter anything as your subscription renews.
  #
  # Without this, a purchased subscription does NOT activate — the key
  # from your purchase email only works here. It is not the same as the
  # long `eyJ0aWVy...` key beta testers are handed directly, and it will
  # be rejected if pasted into the Admin UI.
  #
  # Leave blank ONLY if you were handed a manually-signed key directly
  # (e.g. as a beta tester) — the two are independent, don't set both.
  ls_license_key: ""
  # refresh_url: https://sentinelready-license-refresh.browningjc97.workers.dev/license/refresh  # only override for testing

# ── KUBERNETES (optional) ─────────────────────────────────────
kubernetes:
  # Enable if SentinelReady can reach your cluster API
  # Not required — log snippets will fall back to local files
  enabled: false
  log_lines: 50          # how many recent log lines to pull per pod for AI context
  namespace: default     # which k8s namespace to look for pods/logs in

# ── LOGS ─────────────────────────────────────────────────────
logs:
  snippet_paths:         # local log file(s) to pull recent lines from for AI context
    - /app/sentinel.log
  snippet_limit: 20      # how many recent lines to include per file

# ── STORAGE / DATA RETENTION ──────────────────────────────────
# Nightly housekeeping (2am) purges data past these windows, extracting
# aggregated daily metrics (count/escalations/suppressions per alert
# type) into a small permanent table first, so the statistical record
# survives even after per-event detail ages out. Patterns, context
# rules, correlations, and delivery policy are never purged — only the
# raw event/outcome history below.
storage:
  outcomes_retention_days: 90   # alert_outcomes (resolution history)
  events_retention_days: 90     # events.jsonl (per-alert digest source)
  raw_payload_retention_days: 7 # reserved — no raw payload storage yet
