# Copy to `.env` — docker compose reads it automatically.

# Which Ollama model to pull on first start.
# MUST match `ai.model` in sentinelready.yaml. Compose cannot read that
# file, so the model name is repeated here; a mismatch means the model you
# configured is never downloaded and the first alert falls back to a raw
# (unenriched) alert after the AI call times out.
SENTINEL_MODEL=mistral:7b-instruct-v0.3-q4_K_M

# ---------------------------------------------------------------------------
# BYOK: only if ai.provider is `claude` or `openai_compatible`.
# Leave both unset for the default (Ollama) -- it needs no key.
# Keys live here, never in sentinelready.yaml: that file is mounted into the
# container and is the one you are most likely to paste into a support thread.
# ---------------------------------------------------------------------------
# ai.provider: claude
#ANTHROPIC_API_KEY=sk-ant-...
# ai.provider: openai_compatible  (OpenAI, Azure, Groq, Together, OpenRouter, vLLM)
#SENTINEL_AI_API_KEY=
